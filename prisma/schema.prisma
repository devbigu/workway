generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// BETTER AUTH
// ============================================================

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  role          UserRole  @default(CUSTOMER)
  permissions   String[]  @default([])
  accessEnabled Boolean   @default(true)
  blockedAt     DateTime?
  statusChanges OrderStatusHistory[] @relation("OrderStatusActor")
  adminNotes    OrderAdminNote[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ============================================================
// ORDER ENUMS
// ============================================================

enum UserRole {
  CUSTOMER
  ADMIN
  ORDER_MANAGER
  PRODUCT_MANAGER
  SUPPORT_STAFF
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PLACED
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLATION_REQUESTED
  RETURN_REQUESTED
  RETURNED
  REFUND_PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  REFUNDED
}

enum OrderPaymentStatus {
  NOT_REQUIRED
  PENDING
  AUTHORIZED
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum SellerOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLATION_REQUESTED
  RETURN_REQUESTED
  RETURNED
  REFUND_PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

// ============================================================
// ORDER
// Represents one buyer checkout.
// ============================================================

model Order {
  id             String @id @default(cuid())
  orderNumber    String @unique
  idempotencyKey String @unique

  // Scalar references for now.
  // Convert these into relations when auth and organizations are added.
  userId              String?
  buyerOrganizationId String?

  status        OrderStatus        @default(DRAFT)
  paymentStatus OrderPaymentStatus @default(PENDING)
  currency      String             @default("INR")

  // All monetary values are stored in integer paise.
  subtotalPaise BigInt @default(0)
  discountPaise BigInt @default(0)
  taxPaise      BigInt @default(0)
  shippingPaise BigInt @default(0)
  roundingPaise BigInt @default(0)
  totalPaise    BigInt @default(0)

  // Immutable historical snapshots.
  billingAddressSnapshot  Json
  shippingAddressSnapshot Json
  buyerSnapshot           Json

  notes       String?
  placedAt    DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerOrders SellerOrder[]
  statusHistory OrderStatusHistory[]
  adminNotes OrderAdminNote[]

  @@index([userId, createdAt])
  @@index([buyerOrganizationId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([createdAt])
  @@map("orders")
}


model OrderStatusHistory {
  id String @id @default(cuid())
  orderId String
  fromStatus OrderStatus
  toStatus OrderStatus
  reason String?
  note String?
  changedById String
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy User @relation("OrderStatusActor", fields: [changedById], references: [id], onDelete: Restrict)
  @@index([orderId, createdAt])
  @@map("order_status_history")
}
model OrderAdminNote {
  id String @id @default(cuid())
  orderId String
  authorId String
  body String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([orderId, createdAt])
  @@map("order_admin_notes")
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  entityType String
  entityId String?
  metadata Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================
// SELLER ORDER
// One seller's portion of an Order.
//
// The first release may create only one SellerOrder per Order,
// but this supports multiple sellers later.
// ============================================================

model SellerOrder {
  id                String @id @default(cuid())
  orderId           String
  sellerOrderNumber String @unique

  // Scalar reference until Organization is created.
  sellerOrganizationId String?

  status            SellerOrderStatus @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  subtotalPaise BigInt @default(0)
  discountPaise BigInt @default(0)
  taxPaise      BigInt @default(0)
  shippingPaise BigInt @default(0)
  roundingPaise BigInt @default(0)
  totalPaise    BigInt @default(0)

  // Preserves the seller's historical details.
  sellerSnapshot Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  items OrderItem[]

  @@index([orderId])
  @@index([sellerOrganizationId, createdAt])
  @@index([status, createdAt])
  @@index([fulfillmentStatus, createdAt])
  @@index([createdAt])
  @@map("seller_orders")
}

// ============================================================
// ORDER ITEM
// Immutable snapshot of the purchased product variant.
// ============================================================

model OrderItem {
  id            String @id @default(cuid())
  sellerOrderId String

  // Scalar references until catalogue models are created.
  productId        String?
  productVariantId String?
  sellerOfferId    String?

  // Immutable catalogue snapshot.
  productName     String
  variantName     String?
  sku             String
  catalogueNumber String?
  hsnCode         String?

  // Number of pieces inside one purchasable pack.
  packSize Int @default(1)

  // Example: piece, bottle, box, kit.
  unit String @default("piece")

  // Number of purchased packs.
  quantity Int

  // Price of one complete pack, stored in paise.
  //
  // Example:
  // price = ₹5,200
  // packSize = 100
  // quantity = 2
  //
  // unitPricePaise = 520000
  // subtotalPaise = 1040000
  // total pieces = 200
  unitPricePaise BigInt

  subtotalPaise      BigInt
  discountPaise      BigInt @default(0)
  taxableAmountPaise BigInt
  taxRateBps         Int    @default(0)
  taxPaise           BigInt @default(0)
  totalPaise         BigInt

  // Immutable copies of product, variant, specifications,
  // pricing and seller-offer information.
  productSnapshot Json
  offerSnapshot   Json

  createdAt DateTime @default(now())

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)

  @@index([sellerOrderId])
  @@index([productId])
  @@index([productVariantId])
  @@index([sellerOfferId])
  @@index([sku])
  @@index([catalogueNumber])
  @@index([createdAt])
  @@map("order_items")
}