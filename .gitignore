# Keep source, config, fixtures, and lockfiles in Git.
# Keep generated output, local secrets, machine files, and scratch artifacts out.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/.next-docs/
/out/

# production
/build
/dist/

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.log
*.tmp
*.temp
*.bak
*.backup
*.orig
*~
*.Zone.Identifier
*:Zone.Identifier
*Zone.Identifier

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*

# env files
.env*
!.env.example
!.env.test

# local databases and uploads
*.db
*.db-journal
*.sqlite
*.sqlite3
/uploads/

# deployment
.vercel
.netlify/

# typescript
*.tsbuildinfo
next-env.d.ts

# editor and OS state
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# accidental copied absolute/UNC-path output
/wsl.localhost/
